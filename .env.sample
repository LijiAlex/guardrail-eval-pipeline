# Copy to .env. Nothing here is required for the pipeline to run: without a LangSmith key
# it still answers and still guards, and only loses its traces.

# Turns tracing on. Off is a complete configuration; the pipeline behaves identically.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# Deliberately NOT set. The project is derived from the target this pipeline watches, which
# is the name the target itself reports under — so both halves of a request land in one
# project. Setting it here overrides that and splits the trace in two. Uncomment only to
# send these traces somewhere else on purpose.
# LANGSMITH_PROJECT=

# The guardrail uses the usual AWS credential chain, so these are only needed when that
# chain is not already configured.
# AWS_PROFILE=
# AWS_REGION=ap-south-1
