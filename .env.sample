# Copy to .env. Nothing here is required for the pipeline to run: without a LangSmith key
# it still answers and still guards, and only loses its traces.

# Turns tracing on. Off is a complete configuration; the pipeline behaves identically.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# Deliberately NOT set. The project is derived from the target this pipeline watches, so
# both halves of a request land in one project. Setting it here splits the trace in two.
# LANGSMITH_PROJECT=

# The LLM judge. Without it the report prints the judge section as unavailable rather than
# scoring it zero. The judge stays on Groq rather than moving to OpenAI below: the target
# answers on `openai/gpt-oss-120b`, and grading an OpenAI model with another OpenAI model
# is a weaker separation than a different family from a different company.
GROQ_API_KEY=

# The RAGAS evaluator. Optional — without it RAGAS falls back to the Groq model above,
# whose free tier caps this account at 200,000 tokens a day. One full evaluation spends
# most of that, and a run that exhausts it loses scores silently.
#
# Embeddings stay on Bedrock whichever evaluator is used; changing the embedder would move
# every answer_relevancy score and invalidate the recorded measurements.
OPENAI_API_KEY=

# The guardrail uses the usual AWS credential chain, so these are only needed when that
# chain is not already configured.
# AWS_PROFILE=
# AWS_REGION=ap-south-1
