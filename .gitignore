.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
reports/

# The event log and saved runs are written at runtime and are regenerable, but one of
# each is committed below: without them a clone cannot reproduce the report's guardrail
# counts, `scripts/metrics.py` prints nothing, and `--reuse` has no run to score. They
# hold only synthetic demo data and the evaluation set's own questions.
logs/*
!logs/medibot/
logs/medibot/*
!logs/medibot/events.jsonl

# Saved evaluation runs. latest.json is committed so `--reuse` works from a clone.
runs/*
!runs/latest.json
