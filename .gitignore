.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
reports/

# The event log is written at runtime and is not committed. A representative extract is
# committed instead, so a clone can see the shape of a decision record without carrying
# one machine's traffic. Both hold only synthetic demo data.
logs/*
!logs/medibot/
logs/medibot/*
!logs/medibot/events.jsonl.sample

# Saved evaluation runs. latest.json is committed so `--reuse` works from a clone.
runs/*
!runs/latest.json
